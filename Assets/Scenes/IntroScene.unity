      m_Calls: []
  m_text: "\u041D\u043E \u043F\u0430\u043C\u044F\u0442\u044C \u043B\u044E\u0434\u0435\u0439
    \u043A\u043E\u0440\u043E\u0442\u043A\u0430. \u0421\u0442\u0440\u0430\u0445 \u043F\u0435\u0440\u0435\u0434
    \u041A\u043E\u0446\u0443\u043C\u0430\u0439 \u0441\u0442\u0430\u043B \u0441\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F
    \u0432 \u0438\u0445 \u043F\u0430\u043C\u044F\u0442\u0438. \u0410 \u0431\u0435\u0437
    \u043D\u0435\u0433\u043E, \u043E\u043D\u0438 \u0431\u044B\u0441\u0442\u0440\u043E
    \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B\u0438 \u043E \u0441\u0432\u043E\u0438\u0445
    \u0440\u0430\u0437\u043D\u043E\u0433\u043B\u0430\u0441\u0438\u044F\u0445. \u041D\u043E
    \u0422\u044C\u043C\u0430 \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u0438\u0441\u0447\u0435\u0437\u043B\u0430.
    \u041A\u0430\u043A \u0438 \u0442\u0435, \u043A\u0442\u043E \u0436\u0430\u0436\u0434\u0430\u043B
    \u0435\u0451 \u0441\u0438\u043B\u044B\u2026"
