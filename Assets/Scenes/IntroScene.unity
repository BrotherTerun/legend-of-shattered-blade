  m_text: "\u041F\u0440\u043E\u0448\u043B\u043E \u043D\u0435\u043C\u0430\u043B\u043E
    \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u0439. \u0422\u0435 \u0433\u0435\u0440\u043E\u0438,
    \u0447\u0442\u043E \u0432\u0441\u0442\u0430\u043B\u0438 \u043C\u0435\u0436\u0434\u0443
    \u043B\u044E\u0434\u044C\u043C\u0438 \u0421\u0438\u043D\u043A\u0430\u0439 \u0438
    \u0422\u044C\u043C\u043E\u0439 \u0441\u043C\u043E\u0433\u043B\u0438 \u0432\u0441\u0442\u0443\u043F\u0438\u0442\u044C
    \u043D\u0430 \u041F\u0443\u0442\u044C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043E\u0442\u043A\u0440\u044B\u043B \u043F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C\u0438
    \u0442\u0430\u0439\u043D\u044B \u0418\u0441\u0442\u0438\u043D\u043D\u043E\u0433\u043E
    \u0418\u043C\u0435\u043D\u0438 \u0421\u0432\u0435\u0442\u0430 - \u0441\u0442\u0438\u0445\u0438\u0438,
    \u043E\u0442 \u043D\u0430\u0447\u0430\u043B\u0430 \u043C\u0438\u0440\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0439
    \u0422\u044C\u043C\u0435. \u0421 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u044D\u0442\u043E\u0439
    \u0441\u0438\u043B\u044B, \u043E\u043D\u0438 \u0437\u0430\u0433\u043D\u0430\u043B\u0438
    \u041A\u043E\u0446\u0443\u043C\u0430\u0439 \u0434\u0430\u043B\u0435\u043A\u043E
    \u043D\u0430 \u0441\u0435\u0432\u0435\u0440."
