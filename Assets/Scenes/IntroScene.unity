  m_text: "\u0412\u043E\u0438\u043D\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438 \u0422\u044C\u043C\u0443,
    \u0441\u0442\u0430\u043B\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B
    \u043A\u0430\u043A \u041A\u043B\u0430\u043D \u0421\u0432\u0435\u0442\u0430. \u0418\u0445
    \u043F\u043E\u0447\u0438\u0442\u0430\u043B\u0438 \u043A\u0430\u043A \u0433\u0435\u0440\u043E\u0435\u0432,
    \u0430 \u0438\u0445 \u043F\u043E\u0442\u043E\u043C\u043A\u0430\u043C \u0434\u043E\u0432\u0435\u0440\u0438\u043B\u0438
    \u0445\u0440\u0430\u043D\u0438\u0442\u044C \u043F\u043E\u043A\u043E\u0439 \u0438
    \u043C\u0438\u0440, \u043F\u0440\u0438\u0448\u0435\u0434\u0448\u0438\u0435 \u043D\u0430
    \u0437\u0435\u043C\u043B\u0438 \u0418\u043C\u043F\u0435\u0440\u0438\u0438 \u043F\u043E\u0441\u043B\u0435
    \u0437\u0430\u0442\u0438\u0445\u0448\u0438\u0445 \u0431\u0438\u0442\u0432."
