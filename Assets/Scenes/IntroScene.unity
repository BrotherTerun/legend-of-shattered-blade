  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0421\u043F\u0430\u0441\u0430\u044F\u0441\u044C \u043E\u0442 \u041A\u043E\u0446\u0443\u043C\u0430\u0439,
    \u043B\u044E\u0434\u0438 \u0441\u043E\u0437\u0434\u0430\u043B\u0438 \u0421\u0438\u043D\u043A\u0430\u0439
    - \u043C\u043E\u0433\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
    \u0418\u043C\u043F\u0435\u0440\u0438\u044E \u0447\u044C\u0438 \u0436\u0438\u0442\u0435\u043B\u0438
    \u0445\u043E\u0442\u0435\u043B\u0438 \u043F\u043E\u043A\u043E\u044F \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.
    \u0415\u0434\u0438\u043D\u044B\u043C \u043F\u0435\u0440\u0435\u0434 \u0441\u0442\u0440\u0430\u0445\u043E\u043C
    \u0422\u044C\u043C\u044B, \u0438\u043C \u0431\u044B\u043B\u0438 \u043D\u0443\u0436\u043D\u044B
    \u0442\u0435, \u043A\u0442\u043E \u043F\u043E\u0441\u0432\u044F\u0442\u0438\u0442
    \u0441\u0435\u0431\u044F \u0437\u0430\u0449\u0438\u0442\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
    \u0418\u043C\u0435\u043D\u0438 \u0432 \u0418\u043C\u043F\u0435\u0440\u0438\u0438.
    \u0412\u043E\u0438\u043D\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
    \u0432\u0441\u0451 \u0438\u0437-\u0437\u0430 \u043A\u043E\u0437\u043D\u0435\u0439
    \u0418\u0441\u043A\u0430\u0436\u0430\u044E\u0449\u0435\u0439 \u0422\u044C\u043C\u044B,
    \u0431\u044B\u043B\u0438 \u0433\u043E\u0442\u043E\u0432\u044B \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0441\u0432\u043E\u0438\u043C\u0438 \u0436\u0438\u0437\u043D\u044F\u043C\u0438,
    \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
    \u043F\u043E\u043A\u043E\u0439 \u0418\u043C\u043F\u0435\u0440\u0438\u0438. \u041E\u043D\u0438
    \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u043B\u0438\u0441\u044C, \u0438
    \u0431\u0440\u043E\u0441\u0438\u043B\u0438 \u0435\u0439 \u0432\u044B\u0437\u043E\u0432."
  m_isRightToLeft: 0
